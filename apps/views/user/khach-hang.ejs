<!-- ===== HERO ===== -->
<section class="kh-hero has-decor">
  <span class="page-ghost" aria-hidden="true">Khách hàng</span>
  <span class="page-dots" aria-hidden="true"></span>
  <span class="page-glow" aria-hidden="true"></span>
  <div class="kh-hero__inner">
    <nav class="page-crumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span class="sep">/</span><span>Khách hàng</span></nav>
    <p class="kh-hero__tag">20+ Dự án đã bàn giao</p>
    <h1>Khách hàng của <span>Devora</span></h1>
    <p>Với Devora, mỗi dự án hoàn thành không chỉ là một sản phẩm công nghệ, mà là một lời cảm ơn gửi đến Quý khách hàng. Chúng tôi trân trọng cơ hội được lắng nghe, thấu hiểu và cùng bạn xây dựng một nền tảng website chuyên nghiệp, vững chắc cho sự phát triển lâu dài.</p>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="kh-stats">
  <div class="kh-stats__inner">
    <div class="kh-stat">
      <span class="kh-stat__num">20+</span>
      <span class="kh-stat__label">Dự án đã bàn giao</span>
    </div>
    <div class="kh-stat">
      <span class="kh-stat__num">100%</span>
      <span class="kh-stat__label">Bàn giao mã nguồn</span>
    </div>
    <div class="kh-stat">
      <span class="kh-stat__num">24/7</span>
      <span class="kh-stat__label">Hỗ trợ kỹ thuật</span>
    </div>
    <div class="kh-stat">
      <span class="kh-stat__num">10+</span>
      <span class="kh-stat__label">Lĩnh vực đa ngành</span>
    </div>
  </div>
</section>

<!-- ===== TESTIMONIALS ===== -->
<section class="kh-testimonials">
  <div class="kh-section__inner">
    <div class="kh-section__heading">
      <h2>Những câu chuyện thành công từ các dự án thực tế</h2>
      <p>Cảm ơn vì đã tin tưởng và đồng hành cùng Devora. Mỗi lời chia sẻ là sự ghi nhận quý giá dành cho chúng tôi.</p>
    </div>

    <div class="kh-testimonials__grid">
      <% if (typeof clients !== 'undefined' && clients && clients.length > 0) { %>
        <% clients.forEach(function(c, i) { %>
        <div class="kh-testi-card <%= i === 0 ? 'kh-testi-card--featured' : '' %>">
          <div class="kh-testi-card__quote">"</div>
          <p><%= c.testimonial || '' %></p>
          <div class="kh-testi-card__author">
            <% if (c.avatar) { %>
              <img src="<%= c.avatar %>" class="kh-testi-card__avatar" style="width:44px;height:44px;min-width:44px;border-radius:50%;object-fit:cover;flex-shrink:0;" alt="<%= c.full_name %>">
            <% } else { %>
              <div class="kh-testi-card__avatar"><%= c.full_name.charAt(0).toUpperCase() %></div>
            <% } %>
            <div>
              <strong><%= c.full_name %></strong>
              <span><%= [c.position, c.company].filter(Boolean).join(' - ') %></span>
            </div>
          </div>
          <div class="kh-testi-card__stars">
            <% for(let s=0;s<5;s++){ %><%= s < c.rating ? '★' : '☆' %><% } %>
          </div>
        </div>
        <% }); %>
      <% } else { %>
        <p style="grid-column:1/-1;text-align:center;color:#aaa;padding:40px 0;">Chưa có đánh giá nào.</p>
      <% } %>
    </div>
  </div>
</section>

<!-- ===== DỰ ÁN TIÊU BIỂU ===== -->
<section class="kh-projects">
  <div class="kh-section__inner">
    <div class="kh-section__heading">
      <h2>Mỗi dự án website là một câu chuyện thành công</h2>
      <p>Các dự án thiết kế website chuẩn SEO do Devora triển khai đều được xây dựng dựa trên mục tiêu kinh doanh, trải nghiệm người dùng và khả năng mở rộng lâu dài.</p>
    </div>

    <div class="kh-projects__grid">
      <% (typeof homeProjects !== 'undefined' && homeProjects ? homeProjects : []).forEach(function(prj) { %>
      <div class="kh-project-card">
        <div class="kh-project-card__img">
          <img src="<%= prj.image %>" alt="<%= prj.name %>" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1547658719-da2b51169166?q=80&w=1200&auto=format&fit=crop'">
          <div class="kh-project-card__overlay">
            <a href="https://<%= prj.url %>" target="_blank" rel="noopener">Xem dự án</a>
          </div>
        </div>
        <div class="kh-project-card__body">
          <span class="kh-project-card__cat"><%= prj.cat %></span>
          <h4><%= prj.name %></h4>
          <p><%= prj.desc %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="kh-cta">
  <div class="kh-cta__inner">
    <h2>Bạn đã sẵn sàng để thương hiệu của mình tỏa sáng trên nền tảng số chưa?</h2>
    <p>Bắt đầu ngay hôm nay và tiến gần hơn đến thành công cùng Devora.</p>
    <a href="/lien-he" class="kh-cta__btn">Liên hệ tư vấn miễn phí</a>
  </div>
</section>
