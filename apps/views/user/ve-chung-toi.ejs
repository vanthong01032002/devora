<!-- ===== HERO ===== -->
<section class="about-hero has-decor">
  <span class="page-ghost" aria-hidden="true">Tekora</span>
  <span class="page-dots" aria-hidden="true"></span>
  <span class="page-glow" aria-hidden="true"></span>
  <div class="about-hero__inner">
    <div class="about-hero__text">
      <nav class="page-crumb page-crumb--left" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span class="sep">/</span><span>Về chúng tôi</span></nav>
      <p class="about-hero__tag">Về chúng tôi</p>
      <h1><%= settings.about_hero_heading || 'Chúng tôi là' %> <span><%= settings.about_hero_highlight || 'Tekora' %></span></h1>
      <p><%= settings.about_intro || 'Tekora là đơn vị thiết kế website và chuyển đổi số đáng tin cậy của doanh nghiệp Việt. Chúng tôi đồng hành cùng bạn từ ý tưởng đến sản phẩm hoàn chỉnh, giúp thương hiệu tỏa sáng trên nền tảng số.' %></p>
      <div class="about-hero__actions">
        <a href="/lien-he" class="about-btn about-btn--primary">Liên hệ ngay</a>
        <a href="/dich-vu" class="about-btn about-btn--outline">Xem dịch vụ</a>
      </div>
    </div>
    <div class="about-hero__img">
      <img src="<%= settings.about_hero_image || '/images/illustration-about-hero.png' %>" alt="Đội ngũ Tekora">
      <div class="about-hero__badge about-hero__badge--1">
        <span class="about-hero__badge-num"><%= settings.about_badge1_num || '20+' %></span>
        <span><%= settings.about_badge1_label || 'Dự án đã bàn giao' %></span>
      </div>
      <div class="about-hero__badge about-hero__badge--2">
        <span class="about-hero__badge-num"><%= settings.about_badge2_num || '100%' %></span>
        <span><%= settings.about_badge2_label || 'Bàn giao mã nguồn' %></span>
      </div>
    </div>
  </div>
</section>

<!-- ===== STORY ===== -->
<section class="about-story">
  <div class="about-inner">
    <div class="about-story__img">
      <img src="<%= settings.about_story_image || '/images/illustration-about-story.png' %>" alt="Câu chuyện Tekora">
      <div class="about-story__exp">
        <strong><%= settings.about_exp_num || '5+' %></strong>
        <span><%= settings.about_exp_label || 'Năm kinh nghiệm' %></span>
      </div>
    </div>
    <div class="about-story__content">
      <p class="about-label">Câu chuyện của chúng tôi</p>
      <h2><%= settings.about_story_heading || 'Từ đam mê đến' %> <span><%= settings.about_story_highlight || 'sứ mệnh' %></span></h2>
      <p><%= settings.about_story_p1 || 'Tekora ra đời với niềm tin rằng mỗi doanh nghiệp Việt đều xứng đáng có một nền tảng số vững chắc. Chúng tôi bắt đầu từ một nhóm nhỏ những người đam mê công nghệ và thiết kế, với mong muốn mang lại giải pháp website thực sự hiệu quả cho doanh nghiệp.' %></p>
      <p><%= settings.about_story_p2 || 'Qua nhiều năm phát triển, Tekora đã trở thành đối tác tin cậy của hàng trăm doanh nghiệp thuộc nhiều lĩnh vực khác nhau. Mỗi dự án là một hành trình, mỗi website là một câu chuyện thành công mà chúng tôi tự hào được góp phần tạo nên.' %></p>
      <div class="about-story__points">
        <% const _pts = (settings.about_points ? String(settings.about_points).split(/\r?\n/).map(s => s.trim()).filter(Boolean) : []); const _showPts = _pts.length ? _pts : ['Thiết kế chuẩn SEO, tối ưu chuyển đổi', 'Hỗ trợ tận tâm, đồng hành lâu dài', 'Minh bạch, đúng hạn, đúng cam kết']; %>
        <% _showPts.forEach(function(pt) { %>
        <div class="about-story__point">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
          <%= pt %>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="about-stats">
  <div class="about-stats__inner">
    <div class="about-stat">
      <span class="about-stat__num"><%= settings.about_stat1_num || '20+' %></span>
      <span class="about-stat__label"><%= settings.about_stat1_label || 'Dự án đã bàn giao' %></span>
    </div>
    <div class="about-stat">
      <span class="about-stat__num"><%= settings.about_stat2_num || '100%' %></span>
      <span class="about-stat__label"><%= settings.about_stat2_label || 'Bàn giao mã nguồn' %></span>
    </div>
    <div class="about-stat">
      <span class="about-stat__num"><%= settings.about_stat3_num || '24/7' %></span>
      <span class="about-stat__label"><%= settings.about_stat3_label || 'Hỗ trợ kỹ thuật' %></span>
    </div>
    <div class="about-stat">
      <span class="about-stat__num"><%= settings.about_stat4_num || '10+' %></span>
      <span class="about-stat__label"><%= settings.about_stat4_label || 'Lĩnh vực đa ngành' %></span>
    </div>
  </div>
</section>

<!-- ===== GIÁ TRỊ CỐT LÕI ===== -->
<section class="about-values has-decor">
  <span class="page-ghost" aria-hidden="true">Giá trị</span>
  <div class="about-inner">
    <div class="about-section__heading">
      <p class="about-label">Giá trị cốt lõi</p>
      <h2>Những điều chúng tôi <span>tin tưởng</span></h2>
      <p>Mỗi quyết định, mỗi dòng code, mỗi thiết kế đều được định hướng bởi những giá trị cốt lõi này.</p>
    </div>
    <div class="about-values__grid">
      <div class="about-value-card">
        <div class="about-value-card__icon" style="background:#e8f0fe;color:#1565c0;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        </div>
        <h4>Chất lượng trên hết</h4>
        <p>Mỗi sản phẩm bàn giao đều được kiểm tra kỹ lưỡng, đảm bảo đạt chuẩn cao nhất về kỹ thuật và thẩm mỹ.</p>
      </div>
      <div class="about-value-card">
        <div class="about-value-card__icon" style="background:#e0f7fa;color:#00838f;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        </div>
        <h4>Khách hàng là trung tâm</h4>
        <p>Chúng tôi lắng nghe, thấu hiểu và đặt lợi ích của khách hàng lên hàng đầu trong mọi quyết định.</p>
      </div>
      <div class="about-value-card">
        <div class="about-value-card__icon" style="background:#fff3e0;color:#e65100;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
        </div>
        <h4>Minh bạch & Tin cậy</h4>
        <p>Mọi quy trình, chi phí và tiến độ đều được thông báo rõ ràng. Không có chi phí ẩn, không có bất ngờ.</p>
      </div>
      <div class="about-value-card">
        <div class="about-value-card__icon" style="background:#f3e5f5;color:#6a1b9a;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/></svg>
        </div>
        <h4>Đổi mới liên tục</h4>
        <p>Công nghệ không ngừng thay đổi, chúng tôi luôn cập nhật xu hướng mới nhất để mang lại giải pháp tốt nhất.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== ĐỘI NGŨ ===== -->
<section class="about-team">
  <div class="about-inner">
    <div class="about-section__heading">
      <p class="about-label">Đội ngũ</p>
      <h2>Những con người <span>tạo nên Tekora</span></h2>
      <p>Đội ngũ chuyên gia giàu kinh nghiệm, đam mê và tận tâm với từng dự án.</p>
    </div>
    <div class="about-team__grid">
      <% if (typeof team !== 'undefined' && team && team.length > 0) { %>
        <% team.forEach(function(m) { %>
        <div class="about-team-card">
          <div class="about-team-card__avatar">
            <img src="<%= m.image_path || '/images/default.png' %>" alt="<%= m.full_name %>">
            <div class="about-team-card__social">
              <% if (m.facebook) { %>
              <a href="<%= m.facebook %>" target="_blank" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a>
              <% } %>
              <% if (m.linkedin) { %>
              <a href="<%= m.linkedin %>" target="_blank" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <% } %>
            </div>
          </div>
          <h4><%= m.full_name %></h4>
          <span><%= m.position || '' %></span>
        </div>
        <% }); %>
      <% } else { %>
        <p style="grid-column:1/-1;text-align:center;color:#aaa;padding:40px 0;">Chưa có thành viên nào.</p>
      <% } %>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="about-cta">
  <div class="about-cta__inner">
    <h2><%= settings.about_cta_title || 'Sẵn sàng hợp tác cùng Tekora?' %></h2>
    <p><%= settings.about_cta_text || 'Hãy để chúng tôi giúp bạn xây dựng nền tảng số vững chắc và phát triển bền vững.' %></p>
    <div class="about-cta__actions">
      <a href="/lien-he" class="about-btn about-btn--white">Liên hệ tư vấn</a>
      <a href="/dich-vu" class="about-btn about-btn--outline-white">Xem dịch vụ</a>
    </div>
  </div>
</section>
