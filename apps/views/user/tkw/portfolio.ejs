<!-- Hero -->
<section class="tkw-hero tkw-hero--sm has-decor">
  <span class="page-ghost page-ghost--light" aria-hidden="true">Dự án</span>
  <span class="page-dots page-dots--light" aria-hidden="true"></span>
  <span class="page-glow page-glow--light" aria-hidden="true"></span>
  <div class="tkw-hero__inner tkw-hero__inner--center">
    <div class="tkw-breadcrumb">
      <a href="/">Trang chủ</a> <span>/</span>
      <a href="/thiet-ke-website">Thiết kế Website</a> <span>/</span>
      <span>Dự Án Đã Làm</span>
    </div>
    <h1>Dự Án <span>Đã Làm</span></h1>
    <p>Những website chúng tôi đã xây dựng — mỗi dự án là một câu chuyện thành công.</p>
  </div>
</section>

<!-- Sub-nav -->
<nav class="tkw-subnav">
  <div class="tkw-subnav__inner">
    <a href="/thiet-ke-website" class="tkw-subnav__link">Tổng quan</a>
    <a href="/thiet-ke-website/gioi-thieu" class="tkw-subnav__link">Website Doanh Nghiệp</a>
    <a href="/thiet-ke-website/bang-gia" class="tkw-subnav__link">Bảng giá</a>
    <a href="/thiet-ke-website/portfolio" class="tkw-subnav__link tkw-subnav__link--active">Dự Án Đã Làm</a>
  </div>
</nav>

<!-- Filter + Grid -->
<section class="tkw-portfolio-section">
  <div class="tkw-inner">

    <!-- Filter tabs -->
    <div class="tkw-filter-tabs" id="portfolioFilters">
      <button class="tkw-filter active" data-filter="all">Tất cả</button>
      <button class="tkw-filter" data-filter="ktv">Karaoke KTV</button>
      <button class="tkw-filter" data-filter="lounge">Karaoke &amp; Lounge</button>
    </div>

    <!-- Grid -->
    <div class="tkw-portfolio-grid" id="portfolioGrid">
      <% const projects = (typeof homeProjects !== 'undefined' && homeProjects && homeProjects.length ? homeProjects : []).map(function(prj) { return { cat: prj.cat === 'Karaoke / Lounge' ? 'lounge' : 'ktv', catLabel: prj.cat, name: prj.name, desc: prj.desc, img: prj.image, url: prj.url, tags: prj.chips || [] }; }); %>

      <% projects.forEach(function(p) { %>
      <div class="tkw-portfolio-card" data-cat="<%= p.cat %>">
        <div class="tkw-portfolio-card__img">
          <img src="<%= p.img %>" alt="<%= p.name %>" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1547658719-da2b51169166?q=80&w=1200&auto=format&fit=crop'">
          <div class="tkw-portfolio-card__overlay">
            <a href="https://<%= p.url %>" target="_blank" rel="noopener" class="tkw-btn tkw-btn--white-sm">Xem website</a>
          </div>
          <span class="tkw-portfolio-card__cat"><%= p.catLabel %></span>
        </div>
        <div class="tkw-portfolio-card__body">
          <h4><%= p.name %></h4>
          <p><%= p.desc %></p>
          <div class="tkw-portfolio-card__tags">
            <% p.tags.forEach(function(t) { %><span><%= t %></span><% }); %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

  </div>
</section>

<!-- Stats -->
<section class="tkw-stats">
  <div class="tkw-inner">
    <div class="tkw-stats__grid">
      <div class="tkw-stat"><span class="stat-number">20+</span><span>Dự án đã bàn giao</span></div>
      <div class="tkw-stat"><span class="stat-number">100%</span><span>Bàn giao mã nguồn</span></div>
      <div class="tkw-stat"><span class="stat-number">24/7</span><span>Hỗ trợ kỹ thuật</span></div>
      <div class="tkw-stat"><span class="stat-number">10+</span><span>Lĩnh vực đa ngành</span></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="tkw-cta">
  <div class="tkw-cta__inner">
    <h2>Bạn muốn có website như thế này?</h2>
    <p>Liên hệ ngay để được tư vấn và nhận báo giá miễn phí cho dự án của bạn.</p>
    <div class="tkw-cta__btns">
      <a href="/lien-he" class="tkw-btn tkw-btn--white">Liên hệ tư vấn</a>
      <a href="/thiet-ke-website/bang-gia" class="tkw-btn tkw-btn--outline-white">Xem bảng giá</a>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filters = document.querySelectorAll('.tkw-filter');
  const cards   = document.querySelectorAll('.tkw-portfolio-card');

  filters.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filters.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      const f = btn.dataset.filter;
      cards.forEach(function(card) {
        card.style.display = (f === 'all' || card.dataset.cat === f) ? '' : 'none';
      });
    });
  });
});
</script>
