<% if (typeof schemaJson !== 'undefined' && schemaJson) { %>
<script type="application/ld+json"><%- schemaJson %></script>
<% } %>
<article class="blog-detail">
  <div class="blog-detail__inner">

    <nav class="page-crumb page-crumb--left" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span class="sep">/</span><a href="/blog">Blog</a><span class="sep">/</span><span><%= post.title %></span></nav>

    <div class="blog-detail__header">
      <div class="blog-detail__meta">
        <span><%= new Date(post.created_at).toLocaleDateString('vi-VN') %></span>
        <% if (post.views) { %><span><%= post.views %> lượt xem</span><% } %>
      </div>
      <h1><%= post.title %></h1>
      <% if (post.description) { %><p class="blog-detail__desc"><%= post.description %></p><% } %>
    </div>

    <% if (post.thumbnail) { %>
    <div class="blog-detail__thumb">
      <img src="<%= post.thumbnail %>" alt="<%= post.title %>">
    </div>
    <% } %>

    <div class="blog-detail__content">
      <%- post.content %>
    </div>

    <div class="blog-detail__back">
      <a href="/blog">&larr; Quay lại danh sách</a>
    </div>

  </div>
</article>

<!-- Bài viết liên quan -->
<% if (typeof relatedPosts !== 'undefined' && relatedPosts && relatedPosts.length > 0) { %>
<section class="blog-related has-decor">
  <span class="page-ghost" aria-hidden="true">Blog</span>
  <div class="blog-related__inner">
    <h2>Bài viết liên quan</h2>
    <div class="blog-grid">
      <% relatedPosts.forEach(function(rp) { %>
      <article class="blog-card">
        <a href="/blog/<%= rp.slug %>" class="blog-card__img">
          <img src="<%= rp.thumbnail || '/images/default.png' %>" alt="<%= rp.title %>" loading="lazy">
        </a>
        <div class="blog-card__body">
          <div class="blog-card__meta"><span><%= new Date(rp.created_at).toLocaleDateString('vi-VN') %></span></div>
          <h2 class="blog-card__title"><a href="/blog/<%= rp.slug %>"><%= rp.title %></a></h2>
          <p class="blog-card__desc"><%= rp.description || '' %></p>
          <a href="/blog/<%= rp.slug %>" class="blog-card__btn">Đọc tiếp</a>
        </div>
      </article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
