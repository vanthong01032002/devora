<% const hotline = settings.hotline || '0866.475.366'; %>
<style>
  .nf-wrap{max-width:880px;margin:0 auto;padding:72px 20px 84px;text-align:center}
  .nf-wrap img{width:min(520px,88vw);height:auto;display:block;margin:0 auto}
  .nf-wrap h1{font-family:'Montserrat',sans-serif;font-size:34px;font-weight:800;color:#0d2c54;margin:26px 0 10px}
  .nf-wrap p{font-size:17px;color:#4a6076;line-height:1.65;max-width:560px;margin:0 auto}
  .nf-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:30px}
  .nf-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:10px;font-weight:700;font-size:15.5px;text-decoration:none;transition:.2s}
  .nf-btn.primary{background:#1565c0;color:#fff}
  .nf-btn.primary:hover{background:#0d4c94}
  .nf-btn.ghost{background:#e8f1fb;color:#1565c0}
  .nf-btn.ghost:hover{background:#d5e7fa}
  .nf-hotline{margin-top:20px;font-size:15px;color:#4a6076}
  .nf-hotline a{color:#e8710a;font-weight:800;text-decoration:none}
  @media(max-width:640px){.nf-wrap{padding:48px 16px 60px}.nf-wrap h1{font-size:26px}}
</style>
<section class="nf-wrap">
  <img src="/images/illustration-404.png" alt="404 - Không tìm thấy trang">
  <h1>Oops! Trang này không tồn tại</h1>
  <p>Địa chỉ bạn truy cập không có trên website, đã bị xóa hoặc đã được chuyển sang đường dẫn mới. Đừng lo, bạn có thể quay về trang chủ hoặc xem các dịch vụ của TEKORA.</p>
  <div class="nf-actions">
    <a class="nf-btn primary" href="/"><i class="fas fa-home"></i> Về trang chủ</a>
    <a class="nf-btn ghost" href="/dich-vu"><i class="fas fa-layer-group"></i> Xem dịch vụ</a>
    <a class="nf-btn ghost" href="/kho-giao-dien"><i class="fas fa-palette"></i> Kho giao diện</a>
  </div>
  <p class="nf-hotline">Cần hỗ trợ ngay? Gọi hotline <a href="tel:<%= hotline.replace(/[^0-9]/g, '') %>"><%= hotline %></a></p>
</section>
