<!-- Hero -->
<section class="contact-hero" <% if (contactPage && contactPage.image_path) { %>style="background-image: linear-gradient(rgba(13,45,94,0.75), rgba(13,45,94,0.75)), url('<%= contactPage.image_path %>'); background-size:cover; background-position:center;"<% } %>>
  <div class="contact-hero__inner">
    <nav class="page-crumb page-crumb--light" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span class="sep">/</span><span>Liên hệ</span></nav>
    <h1><%= contactPage && contactPage.title ? contactPage.title : 'Liên hệ với chúng tôi' %></h1>
    <p><%= contactPage && contactPage.description ? contactPage.description : 'Hãy để lại thông tin, chúng tôi sẽ liên hệ lại sớm nhất.' %></p>
  </div>
</section>

<!-- Panel lien he kieu digiz (Giai doan 2) -->
<% if (typeof sent !== 'undefined' && sent) { %>
<div class="contact-success" style="max-width:1100px;margin:28px auto 0;padding:16px 24px;">
  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
  Cảm ơn bạn! Chúng tôi đã nhận được tin nhắn và sẽ liên hệ lại sớm.
</div>
<% } %>

<section class="dv-contact" id="tu-van">
  <div class="dv-contact__panel">
    <span class="dv-contact__decor dv-contact__decor--1"></span>
    <span class="dv-contact__decor dv-contact__decor--2"></span>
    <span class="dv-contact__decor dv-contact__decor--3"></span>
    <span class="dv-contact__dots"></span>
    <div class="dv-contact__left">
      <p class="dv-contact__kicker">— LIÊN HỆ</p>
      <h2>Sẵn sàng nâng tầm thương hiệu số?</h2>
      <p class="dv-contact__sub">Để lại thông tin — TEKORA sẽ liên hệ tư vấn giải pháp &amp; báo giá trong vòng 24 giờ.</p>
      <ul class="dv-contact__info">
        <li>
          <span class="dv-contact__ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg></span>
          <span><small>Hotline</small><a href="tel:0866475366"><strong>0866.475.366</strong></a><% if (typeof settings !== 'undefined' && settings.hotline2) { %><br><a href="tel:<%= settings.hotline2.replace(/\./g,'') %>"><strong><%= settings.hotline2 %></strong></a><% } %></span>
        </li>
        <li>
          <span class="dv-contact__ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></span>
          <span><small>Email</small><strong><%= (typeof settings !== 'undefined' && settings.email) ? settings.email : 'info@tekora.vn' %></strong></span>
        </li>
        <li>
          <span class="dv-contact__ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></span>
          <span><small>Văn phòng</small><strong><%= (typeof settings !== 'undefined' && settings.address) ? settings.address : '213 Chu Văn An, Phường 26, Quận Bình Thạnh, TPHCM' %></strong></span>
        </li>
        <li>
          <span class="dv-contact__ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg></span>
          <span><small>Giờ làm việc</small><strong><%= (typeof settings !== 'undefined' && settings.working_hours) ? settings.working_hours : '8h00 - 17h30 (Thứ 2 - Thứ 7)' %></strong></span>
        </li>
        <li>
          <span class="dv-contact__ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5.1-1.3A10 10 0 1012 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.4.6c-.1.2-.3.4-.1.8.2.4.8 1.4 1.8 2.2 1.2 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 .9c.3.2.5.3.6.4 0 .1 0 .7-.2 1.2z"/></svg></span>
          <span><small>Zalo OA</small><a href="<%= (typeof settings !== 'undefined' && settings.zalo) ? settings.zalo : 'https://zalo.me/0866475366' %>" target="_blank" rel="noopener"><strong>Nhắn tin TEKORA</strong></a></span>
        </li>
      </ul>
    </div>
    <div class="dv-contact__card">
      <h3>Gửi yêu cầu tư vấn</h3>
      <form action="/lien-he" method="POST" id="dvContactForm">
        <div class="dv-contact__row">
          <input type="text" name="full_name" required placeholder="Họ và tên *">
        </div>
        <div class="dv-contact__row dv-contact__row--2">
          <input type="tel" name="phone" required placeholder="Số điện thoại *">
          <input type="email" name="email" placeholder="Email">
        </div>
        <p class="dv-contact__label">Bạn quan tâm</p>
        <div class="dv-contact__pills">
          <% ['Thiết kế Website','UI/UX Design','Phần mềm theo yêu cầu','SEO Website','Nhận diện thương hiệu','Chăm sóc website'].forEach(function(topic, idx) { %>
          <label class="dv-pill"><input type="checkbox" name="interest" value="<%= topic %>" <%= idx === 0 ? 'checked' : '' %>><span><%= topic %></span></label>
          <% }); %>
        </div>
        <div class="dv-contact__row">
          <textarea name="message" rows="3" required placeholder="Mô tả ngắn về dự án"></textarea>
        </div>
        <input type="hidden" name="subject" id="dvContactSubject" value="Yêu cầu tư vấn từ trang liên hệ">
        <button type="submit" class="dv-contact__btn">Gửi yêu cầu tư vấn &rarr;</button>
        <p class="dv-contact__note">Thông tin của bạn được bảo mật — chỉ dùng để tư vấn &amp; báo giá.</p>
      </form>
    </div>
  </div>
</section>
<script>
(function(){
  var form = document.getElementById('dvContactForm');
  if (!form) return;
  form.addEventListener('submit', function(){
    var topics = Array.prototype.map.call(form.querySelectorAll('input[name="interest"]:checked'), function(i){ return i.value; });
    document.getElementById('dvContactSubject').value = 'Yêu cầu tư vấn' + (topics.length ? ': ' + topics.join(', ') : '');
  });
})();
</script>