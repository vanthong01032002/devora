<% const fmtDT = (d) => new Date(d).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' }); %>
<% const displayName = (typeof adminUser !== 'undefined' && adminUser && adminUser.full_name) ? adminUser.full_name : 'Admin'; %>

<!-- ===== Welcome ===== -->
<section class="dash-welcome">
  <div class="dash-welcome__text">
    <h2>Xin chào, <%= displayName %> 👋</h2>
    <p><%= new Date().toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' }) %> · Hôm nay có <strong><%= totalToday %></strong> lượt truy cập<% if (unreadMessages > 0) { %> và <strong><%= unreadMessages %></strong> thư liên hệ chưa đọc<% } %>.</p>
  </div>
  <div class="dash-welcome__actions">
    <a href="/admin/content/news/create" class="dash-btn dash-btn--primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      Viết bài mới
    </a>
    <a href="/" target="_blank" class="dash-btn dash-btn--ghost">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Xem website
    </a>
  </div>
</section>

<!-- ===== Quick info boxes (mẫu NASANI) ===== -->
