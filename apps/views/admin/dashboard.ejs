        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a13.5 13.5 0 0 1 0 18"/><path d="M12 3a13.5 13.5 0 0 0 0 18"/></svg>
      </span>
      <span class="dv-info-box__content">
        <span class="dv-info-box__text">Cấu hình website</span>
        <span class="dv-info-box__more">Xem thêm</span>
      </span>
    </a>
    <a class="dv-info-box" href="/admin/content/news/create" title="Viết bài mới">
      <span class="dv-info-box__icon" style="background:#ff9f43;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      </span>
      <span class="dv-info-box__content">
        <span class="dv-info-box__text">Viết bài mới</span>
        <span class="dv-info-box__more">Xem thêm</span>
      </span>
    </a>
    <a class="dv-info-box" href="/admin/account" title="Tài khoản">
      <span class="dv-info-box__icon" style="background:#ea5455;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/><path d="M3 21v-2a6 6 0 0 1 6-6h1a6 6 0 0 1 6 6v2"/><path d="M16.5 3.2a4 4 0 0 1 0 7.6"/><path d="M21 21v-2a6 6 0 0 0-2.9-5.1"/></svg>
      </span>
      <span class="dv-info-box__content">
        <span class="dv-info-box__text">Tài khoản</span>
        <span class="dv-info-box__more">Xem thêm</span>
      </span>
    </a>
    <a class="dv-info-box" href="/admin/account#doi-mat-khau" title="Đổi mật khẩu">
      <span class="dv-info-box__icon" style="background:#28c76f;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15.5" r="4.5"/><path d="M11.2 12.3L20 3.5"/><path d="M15.5 8l3 3"/></svg>
      </span>
      <span class="dv-info-box__content">
        <span class="dv-info-box__text">Đổi mật khẩu</span>
        <span class="dv-info-box__more">Xem thêm</span>
      </span>
    </a>
    <a class="dv-info-box" href="/admin/mail/contact" title="Thư liên hệ">
      <span class="dv-info-box__icon" style="background:#00cfe8;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M4 8h3M4 12h3M4 16h3"/><circle cx="13.5" cy="10" r="2"/><path d="M10 18c.6-1.7 1.9-2.6 3.5-2.6s2.9.9 3.5 2.6"/></svg>
      </span>
      <span class="dv-info-box__content">
        <span class="dv-info-box__text">Thư liên hệ</span>
        <span class="dv-info-box__more">Xem thêm <% if (unreadMessages > 0) { %><span class="dash-badge"><%= unreadMessages %></span><% } %></span>
      </span>
    </a>
    <a class="dv-info-box" href="/admin/seo-tools/check" title="Check SEO">
      <span class="dv-info-box__icon" style="background:#7367f0;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M8.5 11l2 2 3.5-4"/></svg>
      </span>
      <span class="dv-info-box__content">
